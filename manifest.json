{
  "manifest_version": 3,
  "name": "Skvorling (Скворлинг) — Пассивный английский в контексте",
  "short_name": "Skvorling",
  "version": "2.6.0",
  "description": "Пассивное изучение английского: умная подмена базовых слов с учётом времён и падежей, рандомайзер, навигатор по словам (Ctrl+F) и адаптивный прогресс.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Skvorling — Пассивный английский",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "dashboard/dashboard.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/dictionary.js",
        "src/packs.js",
        "src/nlp.js",
        "src/storage.js",
        "src/content.js"
      ],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-kontext": {
      "suggested_key": {
        "default": "Alt+Shift+E",
        "mac": "Alt+Shift+E"
      },
      "description": "Включить или выключить Skvorling на текущей странице"
    },
    "open-navigator": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Открыть навигатор по переведённым словам на странице"
    }
  }
}
